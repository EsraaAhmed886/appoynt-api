<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Android Test Suite">

    <listeners>
        <listener class-name="listeners.ExecutionListener"/>
        <listener class-name="listeners.TestResultListener"/>
        <listener class-name="listeners.DynamicAllureListener"/>
    </listeners>

    <test name="Authentication Tests">

        <classes>

            <class name="features.Authentication.LoginTest"/>
            <class name="features.Authentication.ForgetPasswordTest"/>
            <class name="features.Authentication.RegisterTest"/>

        </classes>

    </test>

</suite>